# Store source and documentation with LF line endings on every platform.
* text=auto eol=lf

*.py     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.sh     text eol=lf

# Binary formats must never undergo text conversion.
*.zip    binary
*.pdf    binary
*.docx   binary
*.npy    binary
*.npz    binary
*.pt     binary
*.pth    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.bundle binary

# Prediction matrices are byte-sensitive artifacts. Their original line
# endings must be preserved if a file is deliberately added to Git.
*.csv    -text
