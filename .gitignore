# Official data and generated run artifacts. Keep the policy files visible.
data/*
!data/README.md
outputs/*
!outputs/README.md

# Generated submission and review packages.
submission_staging/
submission_code_handoff_*/
submission_review_bundle_*/
docs/submission/*.pdf
docs/submission/*.docx

# Test output, coverage, and build artifacts. Runtime logs belong below the
# configured output root; a stray log elsewhere must remain visible for review.
.coverage
.coverage.*
coverage.xml
htmlcov/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.tmp_*/

# Python environments and bytecode.
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv-*/
venv/
env/

# Local configuration and credentials.
.env
.env.*
!.env.example

# Editor and operating-system metadata.
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
