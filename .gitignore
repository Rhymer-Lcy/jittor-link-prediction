# Data and run artifacts
data/
outputs/
*.log

# Local working notes (consultation briefs, scratch analyses) -- not part of the deliverable
docs_local/

# Python
__pycache__/
*.pyc
.venv/
venv/

# IDE
.idea/
.vscode/
scratchpad/

# Durable evidence copies pulled off a rented instance. Large binary members and
# reconstruction intermediates; provenance lives in artifacts_durable/FINAL_MANIFEST.md.
artifacts_durable/

# Audit-evidence export packages staged for manual off-disk backup. Not canonical
# production inputs and not part of the deliverable.
audit_exports/

# Draft submission staging trees. Generated deterministically by
# tools/submission/stage_package.py from tracked sources; never a release source.
submission_staging/

# Rendered forms of docs/submission/*.md. The markdown is the tracked source.
docs/submission/*.pdf
docs/submission/*.docx

# Generated friend-review bundles. Built by tools from tracked sources; never a release source.
submission_review_bundle_*/
